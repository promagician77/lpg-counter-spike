{
  "functions": { "api/checks.py": { "runtime": "@vercel/python@4.5.0" } },
  "headers": [{ "source": "/(.*)", "headers": [
    { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
    { "key": "X-Content-Type-Options", "value": "nosniff" }
  ]},
  { "source": "/(src|tests|db|scripts)/(.*)", "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }] }
  ]
}
